(pink == \"1,000$\") {\n                if (total >= 1000) {\n                    pink = \"owned\"\n                    total = total - 1000\n                    myMenu.close()\n                    list()\n                    Notification.notify(\"purchased successfully\", 1, assets.image`pinkLogo`)\n                } else {\n                    Notification.notify(\"error 199\", 1, assets.image`exclemationPoint`)\n                }\n            } else {\n                car = assets.image`pinkCar`\n                carType = 2\n                play()\n            }\n        } else if (selectedIndex == 2) {\n            if (America == \"10,000$\") {\n                if (total >= 10000) {\n                    America = \"owned\"\n                    total = total - 10000\n                    myMenu.close()\n                    list()\n                    Notification.notify(\"purchased successfully\", 1, assets.image`americaLogo`)\n                } else {\n                    Notification.notify(\"error 199\", 1, assets.image`exclemationPoint`)\n                }\n            } else {\n                car = assets.image`americaCar`\n                carType = 3\n                play()\n            }\n        } else if (selectedIndex == 3) {\n            if (golfCart == \"100,000$\") {\n                if (total >= 100000) {\n                    golfCart = \"owned\"\n                    total = total - 100000\n                    myMenu.close()\n                    list()\n                    Notification.notify(\"purchased successfully\", 1, assets.image`golfCartLogo`)\n                } else {\n                    Notification.notify(\"error 199\", 1, assets.image`exclemationPoint`)\n                }\n            } else {\n                car = assets.image`golfCart`\n                carType = 4\n                play()\n            }\n        }\n    })\n}\ncontroller.anyButton.onEvent(ControllerButtonEvent.Pressed, function () {\n    Notification.cancelNotification()\n})\nfunction list () {\n    if (myMenu) {\n        sprites.destroy(myMenu)\n    }\n    listOfCars = [\n    miniMenu.createMenuItem(\"owned\", assets.image`redCar`),\n    miniMenu.createMenuItem(pink, assets.image`pinkCar`),\n    miniMenu.createMenuItem(America, assets.image`americaCar`),\n    miniMenu.createMenuItem(golfCart, assets.image`golfCart`)\n    ]\n    myMenu = miniMenu.createMenuFromArray(listOfCars)\n    total = total + info.score()\n    myMenu.setTitle(\"\" + total + \"$\")\n    myMenu.setStyleProperty(miniMenu.StyleKind.Title, miniMenu.StyleProperty.Alignment, 1)\n    info.setScore(0)\n    myMenu.setFrame(assets.image`city`)\n    myMenu.setStyleProperty(miniMenu.StyleKind.Selected, miniMenu.StyleProperty.Background, 9)\n    //myMenu.z = 1\n    myMenu.x = 80\n}\nfunction play () {\n    color.startFadeFromCurrent(color.Black, 1000)\n    myMenu.close()\n    sprites.destroy(shopTitle)\n    speed = 10\n    pause(1000)\n    mySprite = sprites.create(car, SpriteKind.Player)\n    controller.moveSprite(mySprite, 100, 0)\n    mySprite.setStayInScreen(true)\n    mySprite.setPosition(80, 110)\n    color.startFadeFromCurrent(color.originalPalette, 1000)\n    isPlaying = true\n}\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Projectile, function (sprite, otherSprite) {\n    isPlaying = false\n    explosion = sprites.create(assets.image`explosion`, SpriteKind.prompt)\n    explosion.setPosition(mySprite.x, mySprite.y)\n    sprites.destroy(otherSprite)\n    sprites.destroy(sprite)\n    animation.runImageAnimation(\n    explosion,\n    assets.animation`explosionAnim`,\n    500,\n    false\n    )\n    explosion.setVelocity(0, speed)\n    whereItMoves = sprites.create(assets.image`whereItMoves`, SpriteKind.prompt)\n    whereItMoves.setVelocity(0, speed)\n    ambulance = sprites.createProjectileFromSide(assets.image`ambulance`, 0, 0)\n    ambulance.setPosition(80, -7)\n    whereItMoves.setPosition(explosion.x, explosion.y - 16)\n    ambulance.follow(whereItMoves, speed + 10)\n    music.play(music.melodyPlayable(music.bigCrash), music.PlaybackMode.UntilDone)\n    music.play(music.melodyPlayable(music.siren), music.PlaybackMode.InBackground)\n    pause(2000)\n    menu()\n})\nsprites.onOverlap(SpriteKind.Player, SpriteKind.extra, function (sprite, otherSprite) {\n    sprites.destroy(otherSprite)\n    speed += -20\n})\nsprites.onDestroyed(SpriteKind.Projectile, function (sprite) {\n    info.changeScoreBy(carType)\n})\nlet projectile: Sprite = null\nlet coin: Sprite = null\nlet xPicker = 0\nlet ambulance: Sprite = null\nlet listOfCars: miniMenu.MenuItem[] = []\nlet total = 0\nlet carType = 0\nlet car: Image = null\nlet myMenu: miniMenu.MenuSprite = null\nlet shopTitle: Sprite = null\nlet explosion: Sprite = null\nlet whereItMoves: Sprite = null\nlet mySprite: Sprite = null\nlet isPlaying = false\nlet golfCart = \"\"\nlet America = \"\"\nlet pink = \"\"\nlet speed = 0\nscene.setBackgroundImage(assets.image`road`)\nspeed = 10\nscroller.scrollBackgroundWithSpeed(0, speed)\npink = \"1,000$\"\nAmerica = \"10,000$\"\ngolfCart = \"100,000$\"\nisPlaying = false\nmenu()\ngame.onUpdateInterval(5000, function () {\n    if (isPlaying == true) {\n        xPicker = randint(1, 2)\n        coin = sprites.create(assets.image`coin`, SpriteKind.extra)\n        if (xPicker == 1) {\n            coin.setPosition(randint(6, 69), 0)\n        } else if (xPicker == 2) {\n            coin.setPosition(randint(91, 154), 0)\n        }\n        coin.setVelocity(0, speed + 10)\n        mySprite.setFlag(SpriteFlag.AutoDestroy, true)\n    }\n})\ngame.onUpdateInterval(500, function () {\n    if (isPlaying) {\n        xPicker = randint(1, 2)\n        projectile = sprites.createProjectileFromSide(assets.image`enemyCar`, 0, 0)\n        if (xPicker == 1) {\n            projectile.setPosition(randint(6, 69), 0)\n        } else if (xPicker == 2) {\n            projectile.setPosition(randint(91, 154), 0)\n        }\n        projectile.setVelocity(0, speed + 20)\n        projectile.setFlag(SpriteFlag.AutoDestroy, true)\n    }\n})\ngame.onUpdateInterval(100, function () {\n    if (!(projectile)) {\n        return\n    }\n    if (isPlaying) {\n        speed += 1\n        scroller.scrollBackgroundWithSpeed(0, speed)\n        projectile.setVelocity(0, speed + 20)\n    }\n})\n","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myTiles\"\n    }\n}","tilemap.g.ts":"","images.g.jres":"{\n    \"image1\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"road\"\n    },\n    \"image3\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"explosion\"\n    },\n    \"image4\": {\n        \"data\": \"hwQMAA8AAAAAAPH/Ef8AAAAgIi4iIvEAEBEREbEhEg4RERERyxHdAREREbHMEREBERERscwREQERERGxzBERAREREbHMEREBEREREcsR3QEQERERsSESDgAgIi4iIvEAAADx/xH/DwA=\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"ambulance\"\n    },\n    \"image5\": {\n        \"data\": \"hwQMAA8AAAAAAPj/iP8AAABQVViFiPUAUDMzM7XXXQhVd3dVy1fdBXVVVbXMV1UFdVVVtcxXVQVVVVW1zFdVBVVVVbXMV1UFVVVVVctX3QVQMzMztdddCABQVViFiPUAAAD4/4j/DwA=\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"coin\"\n    },\n    \"image6\": {\n        \"data\": \"hwQMAA8AAAAAAPj/iP8AAABgZmiGiPYAYMzMzLbZbQhmmZlmy2ndBpZmZrbMaWYGlmZmtsxpZgZmZma2zGlmBmZmZrbMaWYGZmZmZstp3Q